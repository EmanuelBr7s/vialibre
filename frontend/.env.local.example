# El navegador llama a /api y Next.js reenvía cada prefijo a su servicio.
NEXT_PUBLIC_API_URL=/api

# Destinos del proxy (next.config.js). En producción, las URLs públicas de cada servicio.
AUTH_SERVICE_URL=http://localhost:8001
CORE_SERVICE_URL=http://localhost:8002
MATCH_SERVICE_URL=http://localhost:8003

# ── PostgreSQL (instancia local o administrada) ──
POSTGRES_USER=vialibre
POSTGRES_PASSWORD=vialibre_secret_dev
POSTGRES_DB=vialibre

# ── Auth Service ──
JWT_SECRET_KEY=change-me-in-production-use-a-real-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Database URL (los tres servicios comparten la BD, cada uno en su esquema) ──
DATABASE_URL=postgresql+asyncpg://vialibre:vialibre_secret_dev@localhost:5432/vialibre

# ── URLs internas entre servicios ──
AUTH_SERVICE_URL=http://localhost:8001
CORE_SERVICE_URL=http://localhost:8002
